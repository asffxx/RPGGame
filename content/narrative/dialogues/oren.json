    {
      "id": "life",
      "text": "'Crownward carries royal messages, settles disputes, and protects public offices. A seal should make a promise reliable, not make a person small.'",
      "choices": [
        {
          "id": "personal_topic",
          "text": "Discuss the inspection job you accepted.",
          "next": "personal",
          "conditions": [
            {
              "type": "quest",
              "id": "commission_mileposts",
              "state": "active"
            }
          ]
        },
        {
          "id": "life_back",
          "text": "Thank you.",
          "next": "greeting"
        }
      ]
    },
    {
      "id": "concern",
      "text": "'A widow needs a replacement permit. The rule asks for a witness who moved away years ago.'",
      "choices": [
        {
          "id": "decide_a",
          "text": "Accept two neighbors who can verify her claim.",
          "next": "outcome_a",
          "conditions": [
            {
              "type": "flag",
              "id": "oren_decision",
              "state": "eq",
              "value": 0
            }
          ],
          "effects": [
            {
              "type": "flag",
              "id": "oren_decision",
              "value": 1
            },
            {
              "type": "standing",
              "id": "crownward",
              "value": 2
            }
          ],
          "once": true,
          "result": "Oren remembered your advice: Accept two neighbors who can verify her claim."
        },
        {
          "id": "decide_b",
          "text": "Request a formal exemption and help her submit it.",
          "next": "outcome_b",
          "conditions": [
            {
              "type": "flag",
              "id": "oren_decision",
              "state": "eq",
              "value": 0
            }
          ],
          "effects": [
            {
              "type": "flag",
