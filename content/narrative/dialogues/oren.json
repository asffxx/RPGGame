              "value": 2
            },
            {
              "type": "standing",
              "id": "crownward",
              "value": 2
            }
          ],
          "once": true,
          "result": "Oren remembered your advice: Request a formal exemption and help her submit it."
        },
        {
          "id": "concern_back",
          "text": "I need to think about it.",
          "next": "greeting"
        }
      ]
    },
    {
      "id": "outcome_a",
      "text": "'The purpose is proof, not punishment.' Oren records their testimony and takes responsibility for the decision.",
      "choices": [
        {
          "id": "outcome_a_back",
          "text": "Until next time.",
          "next": "greeting"
        }
      ]
    },
    {
      "id": "outcome_b",
      "text": "'Then I will carry the papers myself.' Oren obtains a temporary permit while the exemption is reviewed.",
      "choices": [
        {
          "id": "outcome_b_back",
          "text": "Until next time.",
          "next": "greeting"
        }
      ]
    },
    {
      "id": "work",
      "text": "Milepost Inspection: Inspect the road markers in Barren Plains and note damaged signs. 'I can register your interest here; any guild hall handles payment.'",
      "choices": [
