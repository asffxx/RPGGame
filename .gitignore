
# ── Build output ─────────────────────────────────────────────────────────────
/build/
/build-win/
/cmake-build-*/
/out/

# CMake generated files (kept out of source tree)
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Testing/

# compile_commands.json is generated per-machine; clangd reads it from build/
compile_commands.json

# ── Compiled / linked artefacts ───────────────────────────────────────────────
*.o
*.obj
*.a
*.so
*.dll
*.exe
# Published Windows release binaries are tracked; local build output is not.
!dist/releases/**/*.exe

# ── Runtime data ──────────────────────────────────────────────────────────────
# Player save file lives next to the executable, never in the repo.
savegame.dat

# Scratch / test output directories written by CTest runs
/crafting-tests/
/data-tests/
/cli-test/

# ── Python ────────────────────────────────────────────────────────────────────
# scripts/ is tracked; its bytecode cache is not.
__pycache__/
*.py[cod]
*.pyo

# ── Temporary / editor ────────────────────────────────────────────────────────
*.tmp
*.swp
*~
.DS_Store
Thumbs.db

# ── IDE / tooling ─────────────────────────────────────────────────────────────
.vscode/
.idea/
.cache/
*.user

# ── Obsidian vault ────────────────────────────────────────────────────────────
# Keep the local Obsidian vault out of version control.
/RPGDOCS/

# ── Development-only material ────────────────────────────────────────────────
# Local documentation, helper scripts, and tests stay off release branches.
/docs/
/scripts/
/tests/
