
# ── Build output ─────────────────────────────────────────────────────────────
/build/
/build-win/
/build-release/
/cmake-build-*/
/out/

# CMake generated files (kept out of source tree)
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Testing/

# compile_commands.json is generated per-machine; clangd reads it from build/
compile_commands.json

# ── Compiled / linked artefacts ───────────────────────────────────────────────
*.o
*.obj
*.a
*.so
*.dll
*.exe

# ── Release packaging output ─────────────────────────────────────────────────
# dist/ holds locally built release packages; staged binaries and checksums
# stay local build output.
/dist/

# ── Runtime data ──────────────────────────────────────────────────────────────
# Player save file lives next to the executable, never in the repo.
savegame.dat

# Scratch / test output directories written by CTest runs
/crafting-tests/
/data-tests/
/cli-test/

# ── Python ────────────────────────────────────────────────────────────────────
# scripts/ is ignored; bytecode caches stay out too.
__pycache__/
*.py[cod]
*.pyo

# ── Temporary / editor ────────────────────────────────────────────────────────
*.tmp
*.swp
*~
.DS_Store
Thumbs.db

# ── IDE / tooling ─────────────────────────────────────────────────────────────
.vscode/
.idea/
.cache/
/.serena/
*.user

# ── Obsidian vault ────────────────────────────────────────────────────────────
# Keep the local Obsidian vault out of version control.
/RPGDOCS/

# ── Knowledge graph (generated) ──────────────────────────────────────────────
# graphify-out/ is local build output from `graphify`; cache + reports stay local.
/graphify-out/

# ── Development-only material ────────────────────────────────────────────────
# Local documentation, helper scripts, and tests stay off the repo.
/docs/
/scripts/
/tests/
