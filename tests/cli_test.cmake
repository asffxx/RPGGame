# End-to-end creation, manual save, restart, and error handling; no Python required.
file(MAKE_DIRECTORY "${SCRATCH}")
file(REMOVE "${SCRATCH}/savegame.dat" "${SCRATCH}/savegame.dat.tmp")

function(run commands)
    file(WRITE "${SCRATCH}/input.txt" "${commands}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env TERM=dumb "${RPG_BINARY}"
        WORKING_DIRECTORY "${SCRATCH}" INPUT_FILE "${SCRATCH}/input.txt"
        OUTPUT_VARIABLE output ERROR_VARIABLE error RESULT_VARIABLE result TIMEOUT 10)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "CLI failed: ${result}: ${error}")
    endif()
    set(output "${output}" PARENT_SCOPE)
endfunction()

function(expect text)
    string(FIND "${output}" "${text}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "CLI output missing: ${text}")
    endif()
endfunction()

function(expect_unchanged)
    file(READ "${SCRATCH}/savegame.dat" current)
    if(NOT current STREQUAL saved)
        message(FATAL_ERROR "Manual save was changed unexpectedly")
    endif()
endfunction()

run("2\n\n3\n")
expect("Continue failed:")
# Reject Human, select Orc; reject Warrior, select Knight; save, exit.
run("1\n1\n2\n8\n1\n1\n2\n2\n1\nCLI Hero\n3\n2\n\n3\n3\n")
foreach(text IN ITEMS "Stat bonuses" "Starting stats with Orc" "Signature: Brace" "Game saved")
    expect("${text}")
endforeach()
file(READ "${SCRATCH}/savegame.dat" saved)
if(NOT saved MATCHES "CLI Hero")
    message(FATAL_ERROR "Saved character missing")
endif()
# Continue and immediately save: no hidden time, wage, or stat changes.
run("2\n1\n1\n\n3\n2\n\n3\n3\n")
expect("Hitpoints: 85/85")
if(output MATCHES "Choose your race:")
    message(FATAL_ERROR "Continue restarted character creation")
endif()
expect_unchanged()
# Starting a new character and exiting must leave the existing slot alone.
run("1\n1\n1\n7\n1\nUnsaved Mage\n3\n3\n")
expect_unchanged()
file(WRITE "${SCRATCH}/savegame.dat" "RPGGAME 999\n")
run("2\n\n3\n")
expect("Unsupported save format or version")
string(LENGTH "${saved}" length)
math(EXPR half "${length} / 2")
string(SUBSTRING "${saved}" 0 ${half} truncated)
file(WRITE "${SCRATCH}/savegame.dat" "${truncated}")
run("2\n\n3\n")
expect("Continue failed:")
file(REMOVE "${SCRATCH}/savegame.dat" "${SCRATCH}/input.txt")
message(STATUS "Passed CLI save/continue and creation flows")
